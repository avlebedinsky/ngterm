+is_agent() {
+  case "$1" in claude | codex | kimi | opencode | pi | gemini | cursor-agent | aider | crush | goose) return 0 ;; esac
+  if [ -n "${NGTERM_AGENT_RE:-}" ]; then
+    [[ $1 =~ $NGTERM_AGENT_RE ]] 2>/dev/null && return 0
+  fi
+  return 1
